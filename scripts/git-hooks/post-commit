#!/bin/sh
#
# post-commit hook: Notify about git commit
#
# Installation: Run `nezha setup-hooks` or manually copy to .git/hooks/

COMMIT_HASH=$(git rev-parse HEAD 2>/dev/null)
COMMIT_MSG=$(git log -1 --pretty=%s 2>/dev/null)
BRANCH=$(git branch --show-current 2>/dev/null)

if [ -z "$COMMIT_HASH" ]; then
    exit 0
fi

GIT_ROOT=$(git rev-parse --show-toplevel 2>/dev/null)
if [ -z "$GIT_ROOT" ]; then
    exit 0
fi

# Load env and announce
cd "$GIT_ROOT"
source .env 2>/dev/null
/opt/homebrew/bin/node "$GIT_ROOT/dist/cli/index.js" announce "📝 **Git Commit**: ${COMMIT_MSG:0:60} on $BRANCH" --priority low 2>/dev/null

exit 0
