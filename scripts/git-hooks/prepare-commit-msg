#!/bin/sh
#
# prepare-commit-msg hook: Quality control + Auto-append agent ID
#
# This hook:
# 1. Validates commit message contains task/issue/inter-review ID (quality control)
# 2. Appends [Agent: xxx] to the commit message
#
# Validation rules:
# - Commit must contain at least one of: [task:], [issue:], [inter-review:]
# - All IDs found must exist in the database (task, issue, or inter_reviews table)
# - If validation fails, commit is blocked with error message
#
# Installation: Run `nezha setup-hooks` or manually copy to .git/hooks/
#

COMMIT_MSG_FILE="$1"
COMMIT_SOURCE="$2"

if [ ! -f "$COMMIT_MSG_FILE" ]; then
    exit 0
fi

# Find the git repository root
GIT_ROOT=$(git rev-parse --show-toplevel 2>/dev/null)
if [ -z "$GIT_ROOT" ]; then
    exit 0
fi

cd "$GIT_ROOT"

# Find node binary - try common locations
if command -v node >/dev/null 2>&1; then
    NODE_BIN="node"
elif [ -x "/opt/homebrew/bin/node" ]; then
    NODE_BIN="/opt/homebrew/bin/node"
elif [ -x "/usr/local/bin/node" ]; then
    NODE_BIN="/usr/local/bin/node"
fi

NEZHA_CLI="$NODE_BIN"
CLI_SCRIPT="dist/cli/index.js"
NEZHA_CMD=""

if [ -n "$NEZHA_CLI" ] && [ -f "$CLI_SCRIPT" ]; then
    NEZHA_CMD="$NEZHA_CLI $CLI_SCRIPT"
elif command -v nezha >/dev/null 2>&1; then
    NEZHA_CMD="nezha"
fi

if [ -n "$NEZHA_CMD" ]; then
    if ! eval "$NEZHA_CMD validate-commit $COMMIT_MSG_FILE" 2>/dev/null; then
        echo ""
        echo "=========================================="
        echo " COMMIT BLOCKED - Quality Control Check"
        echo "=========================================="
        echo ""
        eval "$NEZHA_CMD validate-commit $COMMIT_MSG_FILE"
        exit 1
    fi
fi

if [ -n "$NEZHA_CMD" ]; then
    AGENT_ID=$($NEZHA_CMD agents whoami 2>/dev/null | grep -oE 'S-[a-zA-Z0-9-]+' | head -1 || grep -oE 'G-[a-zA-Z0-9-]+' | head -1 || true)
fi

if [ -z "$AGENT_ID" ]; then
    exit 0
fi

if grep -q "\[Agent:" "$COMMIT_MSG_FILE" 2>/dev/null; then
    exit 0
fi

if grep -q "Vibe-Author:" "$COMMIT_MSG_FILE" 2>/dev/null; then
    exit 0
fi

if [ -s "$COMMIT_MSG_FILE" ]; then
    echo "" >> "$COMMIT_MSG_FILE"
fi

echo "[Agent: $AGENT_ID]" >> "$COMMIT_MSG_FILE"

exit 0
