# Nezha Environment Variables

# PostgreSQL Database (NEZHA_ prefix required by code)
# Note: Password is stored in macOS Keychain as "Nezha PostgreSQL"
# To store password: security add-generic-password -s "Nezha PostgreSQL" -w "your_password"
# To retrieve: security find-generic-password -s "Nezha PostgreSQL" -w
NEZHA_DB_HOST=localhost
NEZHA_DB_PORT=5432
NEZHA_DB_NAME=nezha
NEZHA_DB_USER=postgres
# NEZHA_DB_PASSWORD is optional - will use Keychain if not set

# Embedding Provider Configuration
# Options: ollama (free, local), zhipu (requires API key)
NEZHA_EMBEDDING_PROVIDER=ollama
NEZHA_EMBEDDING_MODEL=nomic-embed-text
NEZHA_EMBEDDING_API_URL=http://localhost:11434

# Zhipu AI API (only needed if using zhipu provider)
# Get your API key from: https://open.bigmodel.cn/
ZHIPU_API_KEY=your_api_key_here

# Heartbeat Interval (default: 30m)
NEZHA_HEARTBEAT_INTERVAL=30000

# Environment (development, production, test)
NEZHA_ENV=development

# Log Level (debug, info, warn, error)
LOG_LEVEL=info

# Encryption Secret (required for encrypting sensitive data)
# Generate a secure random string: openssl rand -base64 32
NEZHA_SECRET=your_secure_secret_here

# Transport Mode (http or cli)
# http: Server-to-server communication with OpenCode server
# cli: Local CLI execution with real-time streaming output
NEZHA_TRANSPORT_MODE=http

# OpenCode API URL (required for http transport mode)
NEZHA_OPENCODE_API_URL=http://localhost:4096
