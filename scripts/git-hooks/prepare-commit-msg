#!/bin/sh
#
# prepare-commit-msg hook: Quality control + Auto-append agent ID
#
# This hook:
# 1. Validates commit message contains task/issue/inter-review ID (quality control)
# 2. Appends [Agent: <semantic-id>] to the commit message
#
# Identity resolution priority:
#   1. Nezha HTTP API (GET /identity) - works from ANY repo
#   2. Nezha CLI (nezha agents whoami) - fallback
#
# Agent ID format (per DEVELOPER_GUIDE.md):
#   S-{source}-{project}-{session}    # Service-specific (has project context)
#   G-{source}-{machine-fingerprint}  # General (no project context)
#
# Validation rules:
# - Commit must contain at least one of: [task:], [issue:], [inter-review:]
# - All IDs found must exist in the database
# - If validation fails, commit is blocked with error message
#
# DEPRECATED: .nezha/agent-id.json is NO LONGER USED.
#   The old flat-file approach caused all AIs to share one ID.
#   Identity is now resolved deterministically via AgentIdentityService.
#
# Installation: Run `nezha setup-hooks` or manually copy to .git/hooks/
#

COMMIT_MSG_FILE="$1"
COMMIT_SOURCE="$2"

if [ ! -f "$COMMIT_MSG_FILE" ]; then
    exit 0
fi

GIT_ROOT=$(git rev-parse --show-toplevel 2>/dev/null)
if [ -z "$GIT_ROOT" ]; then
    exit 0
fi

cd "$GIT_ROOT"

NEZHA_PORT=${NEZHA_PORT:-5999}
NEZHA_API_KEY=${NEZHA_API_KEY:-}

resolve_agent_id_via_api() {
    local url="http://127.0.0.1:${NEZHA_PORT}/identity"
    if [ -n "$NEZHA_API_KEY" ]; then
        url="${url}?api_key=${NEZHA_API_KEY}"
    fi
    local response=$(curl -sf --max-time 5 "$url" 2>/dev/null)
    if [ $? -eq 0 ] && [ -n "$response" ]; then
        echo "$response" | grep -oE '"id"[[:space:]]*:[[:space:]]*"(S-|G-)[^"]+"' | sed 's/.*"[^"]*":[[:space:]]*"\([^"]*\)".*/\1/'
    fi
}

resolve_agent_id_via_cli() {
    local cmd=""
    if command -v nezha >/dev/null 2>&1; then
        cmd="nezha"
    elif [ -f "/Users/jk/gits/hub/tools_ai/nezha/dist/cli/index.js" ] && command -v node >/dev/null 2>&1; then
        cmd="node /Users/jk/gits/hub/tools_ai/nezha/dist/cli/index.js"
    fi

    if [ -n "$cmd" ]; then
        $cmd agents id 2>/dev/null | grep -oE '(S-|G-)[a-zA-Z0-9_-]+'
    fi
}

validate_commit() {
    local cmd=""
    if command -v nezha >/dev/null 2>&1; then
        cmd="nezha"
    elif [ -f "/Users/jk/gits/hub/tools_ai/nezha/dist/cli/index.js" ] && command -v node >/dev/null 2>&1; then
        cmd="node /Users/jk/gits/hub/tools_ai/nezha/dist/cli/index.js"
    fi

    if [ -n "$cmd" ]; then
        # FIXED: Show output instead of suppressing
        eval "$cmd validate-commit $COMMIT_MSG_FILE" 2>&1 || true
    fi
}

AGENT_ID=$(resolve_agent_id_via_api)
if [ -z "$AGENT_ID" ]; then
    AGENT_ID=$(resolve_agent_id_via_cli)
fi

# FIXED: Use SQL fallback when nezha command not available
validate_with_sql() {
    local commit_msg=$(cat "$COMMIT_MSG_FILE")
    if echo "$commit_msg" | grep -qE '\[(task|issue|inter-review):'; then
        return 0
    fi
    return 1
}

validate_commit_quiet() {
    local cmd=""
    if command -v nezha >/dev/null 2>&1; then
        cmd="nezha"
    elif [ -f "/Users/jk/gits/hub/tools_ai/nezha/dist/cli/index.js" ] && command -v node >/dev/null 2>&1; then
        cmd="node /Users/jk/gits/hub/tools_ai/nezha/dist/cli/index.js"
    fi

    if [ -n "$cmd" ]; then
        # FIXED: Show real errors, don't suppress output
        if $cmd validate-commit "$COMMIT_MSG_FILE" 2>&1; then
            return 0
        fi
        return 1
    fi
    
    # FIXED: When no command, use SQL fallback
    echo "[prepare-commit-msg] nezha not found, using SQL fallback..." >&2
    if validate_with_sql; then
        return 0
    fi
    return 1
}

if ! validate_commit_quiet; then
    echo ""
    echo "=========================================="
    echo " COMMIT BLOCKED - Quality Control Check"
    echo "=========================================="
    echo ""
    echo "Your commit message must contain a task or issue ID."
    echo "Example: git commit -m 'Fix bug [task: 43b880df-9d65-48b2-8747-495f310010c3]'"
    echo ""
    echo "To get valid ID, run:"
    echo "  psql -h localhost -U postgres -d nezha -c \"SELECT id, title FROM tasks ORDER BY created_at DESC LIMIT 5;\""
    echo ""
    validate_commit 2>&1 || true
    exit 1
fi

if [ -z "$AGENT_ID" ]; then
    exit 0
fi

if grep -q "\[Agent:" "$COMMIT_MSG_FILE" 2>/dev/null; then
    exit 0
fi

if grep -q "Vibe-Author:" "$COMMIT_MSG_FILE" 2>/dev/null; then
    exit 0
fi

if [ -s "$COMMIT_MSG_FILE" ]; then
    echo "" >> "$COMMIT_MSG_FILE"
fi

echo "[Agent: $AGENT_ID]" >> "$COMMIT_MSG_FILE"

exit 0
