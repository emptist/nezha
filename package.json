{
  "name": "nezha",
  "version": "0.1.0",
  "description": "AI-driven autonomous development system with permanent memory, continuous work, and self-optimization",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "nezha": "./dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "dev:watch": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "start:daemon": "node dist/cli/index.js start",
    "start:cli": "tsx src/cli/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:integration:watch": "vitest --config vitest.integration.config.ts",
    "test:clean": "bash scripts/kill-vitest.sh",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "clean": "rm -rf dist",
    "db:reset": "tsx scripts/reset-db.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "typecheck:watch": "tsc --noEmit --watch",
    "dev:task": "tsx src/cli/index.ts task-add",
    "dev:tasks": "tsx src/cli/index.ts tasks",
    "dev:health": "curl -s http://localhost:4097/health | jq",
    "dev:logs": "tail -f .tmp/nezha.log",
    "dev:repl": "tsx -r tsx repl",
    "dev:quick": "npm run typecheck && npm run build && node dist/cli/index.js",
    "benchmark": "tsx src/benchmarks/run.ts",
    "benchmark:logger": "tsx src/benchmarks/run.ts --logger",
    "benchmark:transport": "tsx src/benchmarks/run.ts --transport",
    "benchmark:agent": "tsx src/benchmarks/run.ts --agent",
    "benchmark:compare": "tsx src/benchmarks/run.ts --compare",
    "predev": "npm run typecheck",
    "prebuild": "npm run typecheck"
  },
  "keywords": [
    "nezha",
    "ai",
    "autonomous",
    "memory",
    "scheduler",
    "learner"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.13.6",
    "dotenv": "^17.3.1",
    "fs-extra": "^11.3.4",
    "pg": "^8.14.1",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.57.1",
    "@typescript-eslint/parser": "^8.57.1",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^10.0.3",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.1",
    "tsx": "^4.21.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.57.1",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
