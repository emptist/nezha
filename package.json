{
  "name": "nezha",
  "version": "0.1.0",
  "description": "AI-driven autonomous development system with permanent memory, continuous work, and self-optimization",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "nezha": "./dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "start:daemon": "node dist/cli/index.js start",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:clean": "bash scripts/kill-vitest.sh",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "nezha",
    "ai",
    "autonomous",
    "memory",
    "scheduler",
    "learner"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "dotenv": "^17.3.1",
    "pg": "^8.14.1",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
