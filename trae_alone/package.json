{
  "name": "trae-reflect",
  "version": "1.0.0",
  "description": "Standalone reflection tool for Trae Editor AI - persists knowledge across sessions",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./TraeReflect": {
      "import": "./dist/TraeReflect.js",
      "types": "./dist/TraeReflect.d.ts"
    }
  },
  "bin": {
    "trae-reflect": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "ai",
    "reflection",
    "knowledge-persistence",
    "trae",
    "nezha",
    "editor-ai",
    "session-continuity"
  ],
  "author": "emptist",
  "license": "MIT",
  "dependencies": {
    "pg": "^8.11.3",
    "dotenv": "^16.3.1"
  },
  "devDependencies": {
    "@types/pg": "^8.10.9",
    "@types/node": "^20.10.0",
    "typescript": "^5.3.0",
    "vitest": "^1.2.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/emptist/nezha.git",
    "directory": "trae_alone"
  },
  "bugs": {
    "url": "https://github.com/emptist/nezha/issues"
  },
  "homepage": "https://github.com/emptist/nezha/tree/main/trae_alone#readme"
}
